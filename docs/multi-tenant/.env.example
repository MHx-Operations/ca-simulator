# Template for the hardened deployment (docker-compose.hardened.yml).
# Copy into .env in the repository root and fill in every empty value.
# .env is gitignored and kept out of the image by .dockerignore; it holds a
# client secret, so keep it that way.

# --- The app (SPA) ---
# The SPA app registration from the main README.
VITE_MSAL_CLIENT_ID=
# Public host name users open, without scheme, e.g. ca-simulator.example.com
PUBLIC_HOST=

# --- Who may sign in ---
# Directory (tenant) ID of YOUR organisation.
ENTRA_TENANT_ID=
# Optional: "*" (default) admits every account that can sign in to that
# tenant; a comma-separated list of domains narrows it,
# e.g. contoso.com,contoso.onmicrosoft.com
OAUTH2_PROXY_EMAIL_DOMAINS=*
# Optional: session lifetime at the sidecar (default 12h) — how long a
# disabled account keeps access.
OAUTH2_PROXY_COOKIE_EXPIRE=12h

# --- The sidecar's own app registration (single-tenant, platform "Web") ---
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# 32 random bytes, URL-safe base64:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=

# --- Network ---
# Address your TLS-terminating reverse proxy connects FROM, as seen inside the
# container, in CIDR form. For a proxy on the Docker host that is the compose
# network's gateway, e.g. 172.18.0.1/32:
#   docker network inspect <project>_default --format '{{(index .IPAM.Config 0).Gateway}}'
OAUTH2_PROXY_TRUSTED_PROXY_IPS=
# Optional: where the sidecar's plain-HTTP port is published on the host.
OAUTH2_PROXY_BIND=127.0.0.1:4180

# --- The tenant list ---
# Host path of your tenants.json (format: public/tenants.example.json).
# Keep it outside the repository, e.g. /srv/ca-simulator/tenants.json
TENANTS_FILE=
